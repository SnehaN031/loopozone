					"name": "PAN Verify",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "pan", "value": "ODZPS8086J", "type": "text" },
								{ "key": "panImage", "type": "file", "src": [] }
							]
						},
						"url": {
							"raw": "{{baseUrl}}/kyc/pan/verify",
							"host": ["{{baseUrl}}"],
							"path": ["kyc", "pan", "verify"]
						}
					}
				},
