						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "gstNumber", "value": "29ABCDE1234F1Z5", "type": "text" },
								{ "key": "gst", "type": "file", "src": [] }
							]
						},
						"url": {
							"raw": "{{baseUrl}}/kyc/gst/verify",
							"host": ["{{baseUrl}}"],
							"path": ["kyc", "gst", "verify"]
						}
					}
				},
