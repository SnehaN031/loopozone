						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"otp\": \"{{aadhaar_otp}}\",\n    \"referenceId\": \"{{aadhaar_ref_id}}\",\n    \"aadhaarNumber\": \"123456789012\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/kyc/aadhaar/verify-otp",
							"host": ["{{baseUrl}}"],
							"path": ["kyc", "aadhaar", "verify-otp"]
						}
					}
				},
