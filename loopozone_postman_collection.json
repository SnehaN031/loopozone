		{
			"name": "KYC APIs",
			"item": [
				{
					"name": "Aadhaar Send OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.referenceId) {",
									"    pm.collectionVariables.set(\"aadhaar_ref_id\", res.referenceId);",
									"}",
									"if (res.devOtp) {",
									"    pm.collectionVariables.set(\"aadhaar_otp\", res.devOtp);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"aadhaarNumber\": \"123456789012\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/kyc/aadhaar/send-otp",
							"host": ["{{baseUrl}}"],
							"path": ["kyc", "aadhaar", "send-otp"]
						}
					}
				},
